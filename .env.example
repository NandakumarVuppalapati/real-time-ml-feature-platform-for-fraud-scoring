# For running scripts directly on your machine (outside Docker Compose,
# e.g. `python training/train.py`), copy this to .env and `export $(cat .env
# | grep -v '^#' | xargs)`, or use a tool like direnv / python-dotenv.
# Inside docker-compose.yml these are already set correctly per-service —
# you don't need this file for `make up`.

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REDIS_CONNECTION_STRING=localhost:6379
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
FEATURE_REPO_PATH=feature_repo
